# PresenceOS environment variables. Copy to .env.local — never commit real keys.

# Optional. When set, the ten LLM-backed specialist agents call Claude through the
# Anthropic API (server-side only). When unset, the app runs in deterministic demo mode.
ANTHROPIC_API_KEY=

# Optional. Force a mode: "demo" (never call a model) or "model" (requires a key).
# Default: "model" if ANTHROPIC_API_KEY is set, otherwise "demo".
PRESENCE_MODE=

# Optional. Model used in model mode. Default: claude-opus-5-5
PRESENCE_MODEL=

# Optional. Artificial per-agent pacing in demo mode (ms), so execution states are
# visible in the UI. Set to 0 to disable. Default: 700
DEMO_AGENT_DELAY_MS=

# Optional. Directory for the local JSON store and uploaded images. Default: ./.data
PRESENCE_DATA_DIR=

# Optional locally, required on Vercel. Redis (Upstash REST) storage instead of the local JSON file.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
